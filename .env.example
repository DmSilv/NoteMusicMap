# Variáveis de ambiente da IA (api/coach.js e api/ai-status.js) (configure na Vercel:
# Project › Settings › Environment Variables). NUNCA coloque a chave real em arquivos do repositório.

# Chaves: cada serviço que tiver chave fica ATIVO; o app escolhe o melhor para cada tipo de pedido
# e troca sozinho se um estiver cheio ou fora do ar. Pelo menos uma é obrigatória.
geminiAPI=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=

# Regras de uso (opcionais)
# AI_PROVIDERS=gemini,groq          # só estes podem ser usados
# AI_ROUTE_TEACHER_REPORT=anthropic,openai   # ordem por tipo: SESSION_SUMMARY, TEACHER_REPORT, STUDY_PLAN, QUESTION
# AI_RPM_GEMINI=8                   # pedidos por minuto de cada serviço (fila): AI_RPM_OPENAI, AI_RPM_GROQ...
# AI_MAX_WAIT_MS=8000               # espera máxima dentro da própria chamada antes de devolver um bilhete de fila
# AI_TICKET_SECRET=                 # segredo dos bilhetes da fila (padrão: derivado das chaves)
# MODEL_OPENAI_FAST=gpt-4o-mini     # trocar o modelo: MODEL_<SERVIÇO>_<FAST|SMART>

# Opcionais
# GEMINI_MODEL=gemini-2.5-flash
# AI_USER_DAILY=5     # análises por pessoa por dia
# AI_COOLDOWN_S=20    # intervalo mínimo entre pedidos da mesma pessoa
# AI_RPM=8            # pedidos por minuto, somando todos (teto do plano gratuito)
# AI_RPD=200          # pedidos por dia, somando todos

# Contadores precisos entre instâncias (Upstash Redis / Vercel KV), opcional:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
